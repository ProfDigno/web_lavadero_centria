<%- include('../partials/header') %>
<div class="page-head"><div><h1>Compras</h1><p>Registro y consulta de compras de productos</p></div><a class="button" href="/compras/nueva">Nueva compra</a></div>
<section class="panel ventas-panel">
  <form class="ventas-filters" method="get" action="/compras">
    <label>Desde<input type="date" name="desde" value="<%= filters.desde %>"></label>
    <label>Hasta<input type="date" name="hasta" value="<%= filters.hasta %>"></label>
    <label class="ventas-client-filter">Proveedor<input type="search" name="proveedor" value="<%= filters.proveedor %>" placeholder="Razón social o RUC"></label>
    <fieldset class="ventas-condition-filter"><legend>Condición</legend>
      <label><input type="checkbox" name="condicion" value="CONTADO" <%= filters.condiciones.includes('CONTADO') ? 'checked' : '' %>><span class="is-cash">CONTADO</span></label>
      <label><input type="checkbox" name="condicion" value="CREDITO" <%= filters.condiciones.includes('CREDITO') ? 'checked' : '' %>><span class="is-credit">CRÉDITO</span></label>
    </fieldset>
    <div class="ventas-filter-actions"><button type="submit">Filtrar</button><a class="button secondary" href="/compras">Limpiar</a></div>
  </form>
  <div class="table-wrap"><table><thead><tr><th>Número</th><th>Fecha</th><th>Proveedor</th><th>Forma de pago</th><th>Condición</th><th>Estado</th><th>Ítems</th><th class="money-cell">Total</th><th></th></tr></thead>
    <tbody>
      <% compras.forEach((compra) => { %><tr class="<%= compra.estado === 'ANULADO' ? 'row-inactive' : '' %>">
        <td><strong><%= compra.numero %></strong></td><td><%= formatDateTimeShort(compra.fecha_compra) %></td><td><%= compra.proveedor_nombre %></td>
        <td><span class="venta-payment-name" style="--venta-payment-color: <%= compra.forma_pago_color || '#687385' %>"><%= compra.forma_pago %></span></td>
        <td><span class="venta-condition-badge <%= compra.condicion === 'CREDITO' ? 'is-credit' : 'is-cash' %>"><%= compra.condicion %></span></td>
        <td><span class="badge <%= compra.estado.toLowerCase() %>"><%= compra.estado %></span></td><td><%= compra.cantidad_items %></td>
        <td class="money-cell"><%= formatMoney(compra.total) %></td><td class="cell-actions"><a href="/compras/<%= compra.idcompra %>">Ver</a></td>
      </tr><% }) %>
      <% if (!compras.length) { %><tr><td colspan="9">Todavía no hay compras registradas.</td></tr><% } %>
    </tbody>
  </table></div>
  <% const pageUrl = (target) => { const p = new URLSearchParams(); if (filters.desde) p.set('desde', filters.desde); if (filters.hasta) p.set('hasta', filters.hasta); if (filters.proveedor) p.set('proveedor', filters.proveedor); filters.condiciones.forEach((v) => p.append('condicion', v)); p.set('pagina', String(target)); return `/compras?${p.toString()}`; }; %>
  <% const totalPages = Math.max(1, Math.ceil(pagination.total / pagination.pageSize)); %>
  <nav class="ventas-pagination" aria-label="Paginación de compras">
    <% if (pagination.page > 1) { %><a class="button secondary" href="<%= pageUrl(pagination.page - 1) %>">Anterior</a><% } else { %><span class="button secondary is-disabled">Anterior</span><% } %>
    <span>Página <strong><%= pagination.page %></strong> de <strong><%= totalPages %></strong> · <%= pagination.total %> compras</span>
    <% if (pagination.page < totalPages) { %><a class="button secondary" href="<%= pageUrl(pagination.page + 1) %>">Siguiente</a><% } else { %><span class="button secondary is-disabled">Siguiente</span><% } %>
  </nav>
</section>
<%- include('../partials/footer') %>
